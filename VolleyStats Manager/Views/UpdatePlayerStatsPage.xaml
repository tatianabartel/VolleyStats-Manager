<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolleyStats_Manager.Views.UpdatePlayerStatsPage"
             Title="Edit Statistics"
             BackgroundColor="{StaticResource DarkBlue}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="0" MaximumWidthRequest="800">

            <!-- Header -->
            <Label Text="EDIT STATISTICS" FontFamily="Montserrat" FontSize="12"
                   TextColor="{StaticResource LightBlue}" CharacterSpacing="2.5"
                   Margin="0,0,0,4"/>
            <Label Text="Match Statistics" FontFamily="MontserratSemiBold" FontSize="30"
                   TextColor="White" Margin="0,0,0,28"/>

            <!-- Player + Match Info Card (read only) -->
            <Border BackgroundColor="White" Padding="20,16" Margin="0,0,0,28"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="PLAYER" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                        <Label Text="{Binding PlayerName}"
                               FontFamily="MontserratSemiBold" FontSize="17"
                               TextColor="{StaticResource DarkGray}"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="MATCH" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                        <Label Text="{Binding MatchName}"
                               FontFamily="MontserratSemiBold" FontSize="17"
                               TextColor="{StaticResource DarkGray}"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Stats Section Header -->
            <Label Text="PERFORMANCE" FontFamily="Montserrat" FontSize="12"
                   TextColor="{StaticResource LightBlue}" CharacterSpacing="2.5"
                   Margin="0,0,0,12"/>

            <!-- Stats Grid -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto"
                  ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,28">

                <!-- Points -->
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White"
                        Padding="16,14" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="POINTS" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                        <Entry Keyboard="Numeric" TextChanged="OnIntegerInput" Text="{Binding PointsScored}"
                               Placeholder="0" PlaceholderColor="{StaticResource LightGray}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource DarkOrange}"
                               FontFamily="MontserratSemiBold" FontSize="26"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Blocks -->
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White"
                        Padding="16,14" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="BLOCKS" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                        <Entry Keyboard="Numeric" TextChanged="OnIntegerInput" Text="{Binding Blocks}"
                               Placeholder="0" PlaceholderColor="{StaticResource LightGray}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource DarkGray}"
                               FontFamily="MontserratSemiBold" FontSize="26"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Aces -->
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White"
                        Padding="16,14" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ACES" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                        <Entry Keyboard="Numeric" TextChanged="OnIntegerInput" Text="{Binding Aces}"
                               Placeholder="0" PlaceholderColor="{StaticResource LightGray}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource DarkGray}"
                               FontFamily="MontserratSemiBold" FontSize="26"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Errors -->
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White"
                        Padding="16,14" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ERRORS" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="Red" CharacterSpacing="1.5"/>
                        <Entry Keyboard="Numeric" TextChanged="OnIntegerInput" Text="{Binding Errors}"
                               Placeholder="0" PlaceholderColor="{StaticResource LightGray}"
                               BackgroundColor="Transparent"
                               TextColor="Red"
                               FontFamily="MontserratSemiBold" FontSize="26"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1.5" Color="#FFCCCC"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Serves -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        BackgroundColor="White" Padding="16,14" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SERVES" FontFamily="MontserratSemiBold" FontSize="11"
                               TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"
                               HorizontalOptions="Center"/>
                        <Entry Keyboard="Numeric" TextChanged="OnIntegerInput" Text="{Binding Serves}"
                               Placeholder="0" PlaceholderColor="{StaticResource LightGray}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource DarkGray}"
                               FontFamily="MontserratSemiBold" FontSize="26"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}"
                                 HorizontalOptions="Center" WidthRequest="80"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="14" Margin="0,0,0,30">
                <Button Grid.Column="0" Text="Cancel"
                        FontFamily="MontserratSemiBold" FontSize="15"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource LightGray}"
                        BorderColor="{StaticResource LightGray}"
                        BorderWidth="1.5"
                        HeightRequest="50" CornerRadius="10"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1" Text="Save Changes"
                        FontFamily="MontserratSemiBold" FontSize="15"
                        BackgroundColor="{StaticResource PrimaryOrange}"
                        TextColor="White"
                        HeightRequest="50" CornerRadius="10"
                        Command="{Binding SaveCommand}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>