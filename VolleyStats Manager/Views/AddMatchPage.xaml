<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolleyStats_Manager.Views.AddMatchPage"
             Title="Add New Match"
             BackgroundColor="{StaticResource DarkBlue}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="0" MaximumWidthRequest="800">

            <!-- Page Header -->
            <Label Text="NEW MATCH" FontFamily="Montserrat" FontSize="12"
                   TextColor="{StaticResource LightBlue}" CharacterSpacing="2.5" Margin="0,0,0,4"/>
            <Label Text="Match Details" FontFamily="MontserratSemiBold" FontSize="30"
                   TextColor="White" Margin="0,0,0,28"/>

            <!-- Date Card -->
            <Border BackgroundColor="White" Padding="20,16" Margin="0,0,0,12"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="MATCH DATE" FontFamily="MontserratSemiBold" FontSize="11"
                           TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                    <DatePicker Date="{Binding MatchDate}"
                                MaximumDate="{Binding MaxMatchDate}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource DarkGray}"
                                FontFamily="MontserratSemiBold"
                                FontSize="16"/>
                </VerticalStackLayout>
            </Border>

            <!-- Opponent Card -->
            <Border BackgroundColor="White" Padding="20,16" Margin="0,0,0,28"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="OPPONENT" FontFamily="MontserratSemiBold" FontSize="11"
                           TextColor="{StaticResource AccentBlue}" CharacterSpacing="1.5"/>
                    <Entry Text="{Binding Opponent}"
                           Placeholder="Enter opponent team name"
                           PlaceholderColor="{StaticResource Gray}"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource DarkGray}"
                           FontFamily="MontserratSemiBold"
                           FontSize="16"/>
                    <BoxView HeightRequest="1.5" Color="{StaticResource LightGray}" Margin="0,2,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Sets Section Header -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                <VerticalStackLayout>
                    <Label Text="SETS" FontFamily="Montserrat" FontSize="12"
                           TextColor="{StaticResource LightBlue}" CharacterSpacing="2.5"/>
                    <Label Text="Score per set" FontFamily="MontserratSemiBold" FontSize="22"
                           TextColor="White"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Add Set"
                        FontFamily="MontserratSemiBold" FontSize="13"
                        BackgroundColor="{StaticResource AccentBlue}"
                        TextColor="White"
                        Padding="16,0" HeightRequest="38" CornerRadius="8"
                        VerticalOptions="Center"
                        Command="{Binding AddSetCommand}"/>
            </Grid>

            <!-- Sets Column Labels -->
            <Grid ColumnDefinitions="44, *, *" ColumnSpacing="10" Padding="4,0,4,8">
                <Label Text="#" FontFamily="MontserratSemiBold" FontSize="11"
                       TextColor="{StaticResource Gray}" CharacterSpacing="1"
                       HorizontalOptions="Center"/>
                <Label Grid.Column="1" Text="OUR POINTS" FontFamily="MontserratSemiBold"
                       FontSize="11" TextColor="{StaticResource Gray}" CharacterSpacing="1"
                       HorizontalOptions="Center"/>
                <Label Grid.Column="2" Text="OPPONENT POINTS" FontFamily="MontserratSemiBold"
                       FontSize="11" TextColor="{StaticResource Gray}" CharacterSpacing="1"
                       HorizontalOptions="Center"/>
            </Grid>

            <!-- Sets List -->
            <CollectionView ItemsSource="{Binding Sets}" Margin="0,0,0,32">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="44, *, *" ColumnSpacing="10">

                            <!-- Set Number Badge -->
                            <Border BackgroundColor="{StaticResource PrimaryBlue}"
                                    WidthRequest="42" HeightRequest="42"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="21"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding SetNumber}" FontFamily="MontserratSemiBold"
                                       FontSize="15" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Our Points -->
                            <Border Grid.Column="1" BackgroundColor="White"
                                    Padding="14,10" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Entry Text="{Binding OurPoints}"
                                           Placeholder="0"
                                           PlaceholderColor="{StaticResource LightGray}"
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource DarkOrange}"
                                           FontFamily="MontserratSemiBold"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           TextChanged="OnIntegerInput"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Opponent Points -->
                            <Border Grid.Column="2" BackgroundColor="White"
                                    Padding="14,10" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Entry Text="{Binding OpponentPoints}"
                                           Placeholder="0"
                                           PlaceholderColor="{StaticResource LightGray}"
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource DarkGray}"
                                           FontFamily="MontserratSemiBold"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           TextChanged="OnIntegerInput"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="14" Margin="0,0,0,30">
                <Button Grid.Column="0" Text="Save Match"
                        FontFamily="MontserratSemiBold" FontSize="15"
                        BackgroundColor="{StaticResource PrimaryOrange}"
                        TextColor="White"
                        HeightRequest="50" CornerRadius="10"
                        Command="{Binding SaveMatchCommand}"/>
                <Button Grid.Column="1" Text="Cancel"
                        FontFamily="MontserratSemiBold" FontSize="15"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource LightGray}"
                        BorderColor="{StaticResource LightGray}"
                        BorderWidth="1.5"
                        HeightRequest="50" CornerRadius="10"
                        Command="{Binding CancelCommand}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>