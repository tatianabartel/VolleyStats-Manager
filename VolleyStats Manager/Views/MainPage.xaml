<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolleyStats_Manager.Views.MainPage"
             Title="Dashboard"
             x:Name="thisPage"
             BackgroundColor="{StaticResource DarkBlue}"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="{StaticResource AccentBlue}">
        <ScrollView>

            <VerticalStackLayout Padding="28,30" Spacing="0" MaximumWidthRequest="1200">

                <!-- Header -->
                <Label Text="{Binding UserName, StringFormat='Welcome back, {0}'}"
                   FontFamily="Montserrat" FontSize="14" TextColor="{StaticResource LightBlue}"
                   Margin="0,0,0,4"/>
                <Label Text="{Binding TeamName}"
                   FontFamily="MontserratSemiBold" FontSize="34" TextColor="White"
                   Margin="0,0,0,24"/>

                <!-- Stat Cards -->
                <HorizontalStackLayout Spacing="16" Margin="0,0,0,32">

                    <Border Stroke="{StaticResource AccentBlue}" StrokeThickness="2"
                        BackgroundColor="White" Padding="20,14" WidthRequest="190">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="PLAYERS" FontFamily="Montserrat" FontSize="11"
                               HorizontalOptions="Center" TextColor="{StaticResource Gray}"
                               CharacterSpacing="1.5"/>
                            <Label Text="{Binding PlayerCount}" FontFamily="MontserratSemiBold"
                               FontSize="30" HorizontalOptions="Center" TextColor="{StaticResource PrimaryBlue}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource AccentBlue}" StrokeThickness="2"
                        BackgroundColor="White" Padding="20,14" WidthRequest="190">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="MATCHES" FontFamily="Montserrat" FontSize="11"
                               HorizontalOptions="Center" TextColor="{StaticResource Gray}"
                               CharacterSpacing="1.5"/>
                            <Label Text="{Binding MatchesCount}" FontFamily="MontserratSemiBold"
                               FontSize="30" HorizontalOptions="Center" TextColor="{StaticResource PrimaryBlue}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource PrimaryOrange}" StrokeThickness="2"
                        BackgroundColor="White" Padding="20,14" WidthRequest="190">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="WIN RATE" FontFamily="Montserrat" FontSize="11"
                               HorizontalOptions="Center" TextColor="{StaticResource Gray}"
                               CharacterSpacing="1.5"/>
                            <Label Text="{Binding WinRate}" FontFamily="MontserratSemiBold"
                               FontSize="30" HorizontalOptions="Center" TextColor="{StaticResource DarkOrange}"/>
                        </VerticalStackLayout>
                    </Border>

                </HorizontalStackLayout>

                <!-- Matches Section -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <Label Text="RECENT MATCHES" FontFamily="MontserratSemiBold" FontSize="13"
                       TextColor="{StaticResource LightBlue}" VerticalOptions="Center"
                       CharacterSpacing="2"/>
                    <Button Grid.Column="1" Text="View all →" FontFamily="MontserratSemiBold"
                        BackgroundColor="Transparent" TextColor="{StaticResource AccentBlue}"
                        Padding="18,0" HeightRequest="38" CornerRadius="8"
                        Command="{Binding ViewAllMatchesCommand}"/>
                </Grid>

                <CollectionView ItemsSource="{Binding RecentMatches}" HeightRequest="270" Margin="0,0,0,28">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete"
                                               BackgroundColor="Red"
                                               Command="{Binding BindingContext.DeleteMatchCommand, Source={x:Reference thisPage}}"
                                               CommandParameter="{Binding .}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border BackgroundColor="White" Padding="18,14"
                                    StrokeThickness="0" Stroke="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto">

                                        <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding BindingContext.TeamName, Source={x:Reference thisPage}}"
                                                   FontFamily="MontserratSemiBold"
                                                   TextColor="{StaticResource DarkGray}" FontSize="17"/>
                                                <Label Text="vs" FontFamily="Montserrat"
                                                   TextColor="{StaticResource Gray}" FontSize="17"
                                                   VerticalOptions="Center"/>
                                                <Label Text="{Binding Opponent}"
                                                   FontFamily="MontserratSemiBold"
                                                   TextColor="{StaticResource DarkGray}" FontSize="17"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="Score" FontFamily="Montserrat"
                                                   TextColor="{StaticResource Gray}" FontSize="13"
                                                   VerticalOptions="Center"/>
                                                <Label Text="{Binding SetsWon}" FontFamily="MontserratSemiBold"
                                                   TextColor="{StaticResource DarkOrange}" FontSize="15"/>
                                                <Label Text=":" FontFamily="MontserratSemiBold"
                                                   TextColor="{StaticResource Gray}" FontSize="15"/>
                                                <Label Text="{Binding SetsLost}" FontFamily="MontserratSemiBold"
                                                   TextColor="{StaticResource DarkOrange}" FontSize="15"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                            <Button Text="Detail" FontFamily="MontserratSemiBold"
                                                BackgroundColor="{StaticResource PrimaryOrange}"
                                                TextColor="White" WidthRequest="100" HeightRequest="36"
                                                CornerRadius="8"
                                                Command="{Binding BindingContext.ViewMatchDetailCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>
                                            <Button Text="Edit" FontFamily="MontserratSemiBold"
                                                BackgroundColor="{StaticResource LightGray}"
                                                TextColor="{StaticResource DarkGray}" WidthRequest="80"
                                                HeightRequest="36" CornerRadius="8"
                                                Command="{Binding BindingContext.EditMatchCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Players Section -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <Label Text="PLAYERS" FontFamily="MontserratSemiBold" FontSize="13"
                       TextColor="{StaticResource LightBlue}" VerticalOptions="Center"
                       CharacterSpacing="2"/>
                    <Button Grid.Column="1" Text="View all →" FontFamily="MontserratSemiBold"
                        BackgroundColor="Transparent" TextColor="{StaticResource AccentBlue}"
                        Padding="18,0" HeightRequest="38" CornerRadius="8"
                        Command="{Binding ViewAllPlayersCommand}"/>
                </Grid>

                <CollectionView ItemsSource="{Binding TeamPlayers}" HeightRequest="270" Margin="0,0,0,28">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete"
                                               BackgroundColor="Red"
                                               Command="{Binding BindingContext.DeletePlayerCommand, Source={x:Reference thisPage}}"
                                               CommandParameter="{Binding .}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border BackgroundColor="White" Padding="18,14"
                                    StrokeThickness="0" Stroke="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="48, *, Auto">

                                        <!-- Jersey number circle -->
                                        <Border BackgroundColor="{StaticResource DarkBlue}"
                                            WidthRequest="42" HeightRequest="42"
                                            VerticalOptions="Center" HorizontalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="21"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Number}" FontFamily="MontserratSemiBold"
                                               FontSize="16" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="14,0">
                                            <Label Text="{Binding FirstName}" FontFamily="Montserrat"
                                               FontSize="12" TextColor="{StaticResource Gray}"/>
                                            <Label Text="{Binding LastName}" FontFamily="MontserratSemiBold"
                                               FontSize="17" TextColor="{StaticResource DarkGray}"/>
                                            <Label Text="{Binding Position}" FontFamily="Montserrat"
                                               FontSize="12" TextColor="{StaticResource AccentBlue}"/>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                            <Button Text="Detail" FontFamily="MontserratSemiBold"
                                                BackgroundColor="{StaticResource PrimaryOrange}"
                                                TextColor="White" WidthRequest="100" HeightRequest="36"
                                                CornerRadius="8"
                                                Command="{Binding BindingContext.ViewPlayerStatsCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>
                                            <Button Text="Edit" FontFamily="MontserratSemiBold"
                                                BackgroundColor="{StaticResource LightGray}"
                                                TextColor="{StaticResource DarkGray}" WidthRequest="80"
                                                HeightRequest="36" CornerRadius="8"
                                                Command="{Binding BindingContext.EditPlayerCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Top players statistics -->
                <Border BackgroundColor="White" Padding="22,20" Margin="0,0,0,30"
                    StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="TOP PERFORMERS" FontFamily="MontserratSemiBold"
                                   FontSize="13" TextColor="{StaticResource AccentBlue}"
                                   CharacterSpacing="2"/>
                                <Label Text="Top 3 players this season" FontFamily="Montserrat"
                                   FontSize="18" TextColor="{StaticResource DarkGray}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="View all →" FontFamily="MontserratSemiBold"
                                BackgroundColor="Transparent" TextColor="{StaticResource AccentBlue}"
                                Command="{Binding ViewAllStatsCommand}" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource LightGray}"/>

                        <Grid ColumnDefinitions="*, 64, 64, 64, 64" Padding="4,0">
                            <Label Text="Player" FontFamily="MontserratSemiBold" FontSize="12"
                               TextColor="{StaticResource Gray}" CharacterSpacing="1"/>
                            <Label Grid.Column="1" Text="PTS" FontFamily="MontserratSemiBold"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{StaticResource Gray}" CharacterSpacing="1"/>
                            <Label Grid.Column="2" Text="ACE" FontFamily="MontserratSemiBold"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{StaticResource Gray}" CharacterSpacing="1"/>
                            <Label Grid.Column="3" Text="BLK" FontFamily="MontserratSemiBold"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{StaticResource Gray}" CharacterSpacing="1"/>
                            <Label Grid.Column="4" Text="ERR" FontFamily="MontserratSemiBold"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{StaticResource Gray}" CharacterSpacing="1"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource LightGray}"/>

                        <CollectionView ItemsSource="{Binding TopThreePlayers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 64, 64, 64, 64" Padding="4,10">
                                        <Label Text="{Binding PlayerName}" FontFamily="MontserratSemiBold"
                                           FontSize="15" VerticalOptions="Center"
                                           TextColor="{StaticResource DarkGray}"/>
                                        <Label Grid.Column="1" Text="{Binding Points}"
                                           FontFamily="MontserratSemiBold" FontSize="16"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{StaticResource DarkOrange}"/>
                                        <Label Grid.Column="2" Text="{Binding Aces}"
                                           FontFamily="Montserrat" FontSize="15"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{StaticResource DarkGray}"/>
                                        <Label Grid.Column="3" Text="{Binding Blocks}"
                                           FontFamily="Montserrat" FontSize="15"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{StaticResource DarkGray}"/>
                                        <Label Grid.Column="4" Text="{Binding Errors}"
                                           FontFamily="Montserrat" FontSize="15"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="Red"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>